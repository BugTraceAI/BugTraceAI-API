# Copy to .env and configure only the provider(s) you use.
# Never commit .env or provider_secrets.json.

# Optional: pin a provider. Leave blank to use config/apex.json.
APEX_PROVIDER=
APEX_ENABLED=true
APEX_MIN_SEVERITY=info

# External AI providers (optional).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GLM_API_KEY=

# Local Ollama provider (used when APEX_PROVIDER=local). Compose reaches the
# host through host.docker.internal; local non-Compose runs may use localhost.
OLLAMA_URL=http://host.docker.internal:11434
APEX_MODEL=apex-master:latest

# Standalone defaults. Change occupied ports before starting Compose.
# The Launcher writes its selected values instead when it manages this service.
MCP_PORT=8004
API_PORT=8005

# Shared Docker network used by the Launcher-managed WEB and API projects.
BTAI_SHARED_NETWORK=bugtraceai-platform
